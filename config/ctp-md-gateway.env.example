# Non-secret gateway settings. Install on ECS as /etc/ctp-md/ctp-md.env.
CTP_MD_FRONT=tcp://broker-market-front.example:12345
CTP_BROKER_ID=replace-me
CTP_INSTRUMENT_FILE=/etc/ctp-md/instruments.txt
CTP_LISTEN_HOST=127.0.0.1
CTP_LISTEN_PORT=19001
CTP_REPLAY_TICKS=10000
CTP_FLOW_PATH=/var/lib/ctp-md/flow/
