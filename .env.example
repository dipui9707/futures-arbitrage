# Local MVP; all paths are relative to this project unless absolute.
DATA_SOURCE=mock
HOST=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8767
DATABASE_PATH=data/arbitrage.sqlite3
# Hybrid production mode: set DATA_SOURCE=simnow_tqsdk. SimNow supplies current
# quotes from the local replicated SQLite database; TqSdk supplies history/catalogue.
# CTP_MINUTE_DATABASE=data/ctp_minute_bars.sqlite3
# CTP_MAX_FEED_AGE_SECONDS=30
# TqSdk-only mode remains available with DATA_SOURCE=tqsdk.
# Prefer a private external file so credentials are not duplicated into this project.
# TQSDK_AUTH_FILE=/absolute/path/to/private-tqsdk.env
# Alternatively: TQSDK_AUTH=user,password
# TQSDK_TIMEOUT_SECONDS=12
# TQSDK_MAX_QUOTE_AGE_SECONDS=120
# Optional proxy destination, normally derived from BACKEND_PORT.
# BACKEND_URL=http://127.0.0.1:8767
# Never add broker accounts or trading credentials to tracked files.
